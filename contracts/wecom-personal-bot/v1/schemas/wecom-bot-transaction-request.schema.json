{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example.invalid/wecom-personal-bot/v1/wecom-bot-transaction-request.schema.json",
  "title": "Create WeCom personal bot transaction request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "clientCapabilities"],
  "properties": {
    "contractVersion": { "const": "wecom-bot-transaction.v1" },
    "clientCapabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "contains": { "const": "messaging-channel-policy.v1" },
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      }
    }
  }
}
