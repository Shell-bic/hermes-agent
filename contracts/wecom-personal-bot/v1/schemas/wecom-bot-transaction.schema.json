{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example.invalid/wecom-personal-bot/v1/wecom-bot-transaction.schema.json",
  "title": "WeCom personal bot transaction response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "transactionId", "status", "authorizationUrl", "expiresAt", "errorCode"],
  "properties": {
    "contractVersion": { "const": "wecom-bot-transaction.v1" },
    "transactionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "status": {
      "enum": ["pending", "authorized", "redeeming", "completed", "denied", "expired", "canceled", "error"]
    },
    "authorizationUrl": {
      "type": ["string", "null"],
      "maxLength": 2048,
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://(?![^/?#]*@)[^/?#\\s]+(?:[/?#]|$)"
    },
    "expiresAt": { "type": "string", "format": "date-time" },
    "errorCode": {
      "type": ["string", "null"],
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "pending" } }, "required": ["status"] },
      "then": { "properties": { "authorizationUrl": { "type": "string" } } }
    }
  ]
}
